generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  DONOR
  NGO
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  COMPLETED
  CANCELED
}

enum CampaignCompletionReason {
  GOAL_REACHED
  MANUAL
}

enum DonationStatus {
  PENDING
  RECEIVED
  CANCELED
}

model User {
  id           String        @id @default(cuid())
  name         String
  email        String        @unique
  passwordHash String
  role         UserRole
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  organization Organization?
  donations    Donation[]

  @@index([role])
}

model Organization {
  id          String     @id @default(cuid())
  userId      String     @unique
  name        String
  cnpj        String?    @unique
  description String
  phone       String?
  city        String
  state       String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaigns   Campaign[]

  @@index([city, state])
}

model Category {
  id        String     @id @default(cuid())
  name      String     @unique
  slug      String     @unique
  campaigns Campaign[]
}

model Campaign {
  id               String         @id @default(cuid())
  organizationId   String
  categoryId       String
  title            String
  description      String
  goalQuantity     Int
  receivedQuantity Int            @default(0)
  unit             String
  startDate        DateTime       @default(now())
  endDate          DateTime?
  status           CampaignStatus @default(ACTIVE)
  completionReason CampaignCompletionReason?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  organization     Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category         Category       @relation(fields: [categoryId], references: [id])
  donations        Donation[]

  @@index([organizationId])
  @@index([categoryId])
  @@index([status])
}

model Donation {
  id         String         @id @default(cuid())
  donorId    String
  campaignId String
  quantity   Int
  note       String?
  status     DonationStatus @default(PENDING)
  createdAt  DateTime       @default(now())
  receivedAt DateTime?
  updatedAt  DateTime       @updatedAt
  donor      User           @relation(fields: [donorId], references: [id], onDelete: Cascade)
  campaign   Campaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([donorId])
  @@index([campaignId])
  @@index([status])
}
